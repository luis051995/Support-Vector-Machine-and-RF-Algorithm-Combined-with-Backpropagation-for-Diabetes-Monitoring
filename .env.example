# Para LOCAL ejecuta python setup_local.py. Esta plantilla no contiene secretos válidos.
APP_ENV=development
DJANGO_SECRET_KEY=
DATA_ENCRYPTION_KEYS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: runtime limitado polisalud_app; migradora distinta y solo en arranque.
DATABASE_URL=
MIGRATION_DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
TRUST_RENDER_PROXY=0

# DATABASE_URL y DATABASE_URL_UNPOOLED los administra neon env pull.
# APP_DATABASE_URL usa polisalud_app y no debe sobrescribirse al volver a desplegar.
APP_DATABASE_URL=
DATABASE_URL_UNPOOLED=
