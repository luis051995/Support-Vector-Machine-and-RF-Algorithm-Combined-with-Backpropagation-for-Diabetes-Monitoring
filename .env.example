# Para LOCAL ejecuta python setup_local.py. Esta plantilla no contiene secretos válidos.
APP_ENV=development
DJANGO_SECRET_KEY=
DATA_ENCRYPTION_KEYS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: runtime limitado polisalud_app; migradora distinta y solo en arranque.
DATABASE_URL=
MIGRATION_DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
TRUST_RENDER_PROXY=0
